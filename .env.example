# -----------------------------------------------------------------------------
# MasterDeOrca Environment Configuration (Template)
# -----------------------------------------------------------------------------
# Copy this file to .env and fill in the values. Never commit .env to version control.

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------
# General application configuration
APP_ENV=render

# -----------------------------------------------------------------------------
# Server & Deployment
# -----------------------------------------------------------------------------
# Port the API server listens on
QUES_PORT=8000

# Comma-separated list of allowed CORS origins
QUES_CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173

# -----------------------------------------------------------------------------
# Database & Turso
# -----------------------------------------------------------------------------
# Required application database backend. Local SQLite is not supported at runtime.
DATABASE_BACKEND=turso
DATABASE_PATH=./data/masterdeorca.sqlite

# Turso (libSQL) connection details
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=

# Runtime ignores DATABASE_PATH; it is only used by explicit offline legacy-data tools.

# -----------------------------------------------------------------------------
# File & Storage Settings
# -----------------------------------------------------------------------------
# Root directory for storage (used for BLOB references)
QUES_STORAGE_ROOT=/data
# Default subject created on startup
QUES_DEFAULT_SUBJECT=OperatingSys
# Maximum upload size in MB
QUES_MAX_UPLOAD_MB=50
# Legacy name for the app's Turso BLOB storage mode (does not select local SQLite).
STORAGE_BACKEND=sqlite

# -----------------------------------------------------------------------------
# Authentication & Security
# -----------------------------------------------------------------------------
# JWT secret key (must be at least 32 characters)
QUES_JWT_SECRET=
# JWT token TTL in minutes
QUES_JWT_TTL_MINUTES=480

# Initial admin credentials
QUES_ADMIN_EMAIL=
QUES_ADMIN_PASSWORD=

# TOTP Two-Factor Authentication
# Key for encrypting TOTP secrets at rest (32+ bytes, base64 or urlsafe)
QUES_TOTP_ENCRYPTION_KEY=
QUES_TOTP_ISSUER=Smart QPG
QUES_TOTP_CHALLENGE_TTL_MINUTES=5
QUES_TOTP_FAILED_ATTEMPT_THRESHOLD=5
QUES_TOTP_COOLDOWN_SECONDS=120

# -----------------------------------------------------------------------------
# Background Jobs & Scheduler
# -----------------------------------------------------------------------------
# Enable/disable reconciliation worker
QUES_RECONCILE_ENABLED=true
# Reconciliation interval in hours (must be 12 or 24)
QUES_RECONCILE_INTERVAL_HOURS=12

# -----------------------------------------------------------------------------
# Parser Configuration
# -----------------------------------------------------------------------------
# Parser mode: 'llm' for NVIDIA Lite, 'local' for local parser
PARSER_MODE=llm

# -----------------------------------------------------------------------------
# NVIDIA Lite Configuration
# -----------------------------------------------------------------------------
# NVIDIA API keys (comma-separated). NVIDIA_API_KEY also supported.
NVIDIA_API=
NVIDIA_API_KEY=
QUESTION_GENERATION_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
QUESTION_GENERATION_BASE_URL=https://integrate.api.nvidia.com/v1
QUESTION_GENERATION_TEMPERATURE=1.0
QUESTION_GENERATION_TOP_P=0.95
QUESTION_GENERATION_MAX_TOKENS=16384
QUESTION_GENERATION_ENABLE_THINKING=true
QUESTION_GENERATION_CONCURRENCY=3
QUESTION_GENERATION_BATCH_SIZE=3
QUESTION_GENERATION_RETRIES=3
QUESTION_GENERATION_MAX_RETRIES=2
NVIDIA_API_KEYS=
NVIDIA_API_TIMEOUT=300
NVIDIA_API_RETRIES=3
NVIDIA_API_CONCURRENCY=2
NVIDIA_API_BACKOFF_BASE=1.0

# NVIDIA model endpoints and settings
NVIDIA_PARSE_MODEL=nvidia/nemotron-3.5-parse
NVIDIA_STRUCTURE_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
NVIDIA_PARSE_ENDPOINT=https://ai.api.nvidia.com/v1/retrieval/nvidia/nemotron-3.5-parse/parse
NVIDIA_STRUCTURE_ENDPOINT=https://integrate.api.nvidia.com/v1/chat/completions
NVIDIA_STRUCTURE_RETRIES=3
NVIDIA_STRUCTURE_MAX_TOKENS=4096
NVIDIA_STRUCTURE_TIMEOUT=240
NVIDIA_STRUCTURE_CONNECT_TIMEOUT=20
NVIDIA_STRUCTURE_READ_TIMEOUT=240
NVIDIA_STRUCTURE_BACKOFF_BASE=1.0
NVIDIA_STRUCTURE_REASONING_EFFORT=low

# Lite mode batch processing settings
LITE_STAGE2_BLOCK_BATCH_SIZE=2
LITE_STAGE2_BLOCK_OVERLAP=0
LITE_STAGE2_CONCURRENCY=3

# -----------------------------------------------------------------------------
# Local Parser Configuration
# -----------------------------------------------------------------------------
# GPU requirements for local parser
QUES_MIN_FREE_VRAM_MB=1500

# Optional parser output overrides for batch CLI use
# QUES_QUESTIONS_OUTPUT=../CS_MAIN/SUBJECTS/OperatingSys/output/Parser/questions_parsed.json

# -----------------------------------------------------------------------------
# AI Model Providers & API Keys (Legacy/Additional)
# -----------------------------------------------------------------------------
# Reconstruction provider settings
QUES_RECON_PROVIDER=auto
QUES_RECON_MODEL=
QUES_RECON_INPUT_JSON=
QUES_RECON_SAMPLE_PDF=
QUES_RECON_SAMPLE_COUNT=5
QUES_RECON_SAMPLE_SEED=
